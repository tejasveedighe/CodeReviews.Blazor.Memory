@using System.Text
@inject GameStore GameStore;

<div class="flip-card @(Secret.Visible ? "flipped" : "") @(Secret.HightlightType == HightlightType.Match ? "match" : "")">
    <div class="flip-card-inner">
        <div class="flip-card-front">
            <MudButton Disabled="Secret.Visible" OnClick="OnClick" Class="card-button-front">
                <MudIcon Icon="@Icons.Material.Filled.Casino" Size="Size.Large" Class="card-back-icon" />
            </MudButton>
        </div>
        <div class="flip-card-back">
            <MudButton Disabled="Secret.Visible"
                       OnClick="OnClick"
                       Class="card-button-back">
                <MudCard Class="card-content">
                    <MudCardContent Class="card-inner-content">
                        @if (Secret.Type == typeof(string))
                        {
                            <MudText Class="card-text-secret">@Secret.Value.ToString()</MudText>
                        }
                        else if (Secret.Type == typeof(File))
                        {
                            <MudImage Class="card-img-secret" Src="@Secret.Value.ToString()" Alt="Secret Image"></MudImage>
                        }
                    </MudCardContent>
                </MudCard>
            </MudButton>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public required ISecret Secret { get; set; }

    private void OnClick()
    {
        if (!Secret.Visible) 
        {
            AppEvents.Instance.PublishCardClick(Secret.Id);
        }
    }
}

<style>
    :root {
        --card-width: 120px;
        --card-height: 160px;
        --card-border-radius: 10px;
        --card-background-front: #3f51b5; /* Indigo */
        --card-background-back: #e8eaf6; /* Light Indigo */
        --card-text-color: #ffffff;
        --card-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2);
        --card-match-border: 4px solid #4CAF50; /* Green */
        --card-transition-speed: 0.1s;
    }

    .flip-card {
        background-color: transparent;
        width: var(--card-width);
        height: var(--card-height);
        perspective: 1000px; /* 3D effect */
        border-radius: var(--card-border-radius);
        box-shadow: var(--card-shadow);
        cursor: pointer;
    }

    .flip-card-inner {
        position: relative;
        width: 100%;
        height: 100%;
        text-align: center;
        transition: transform var(--card-transition-speed);
        transform-style: preserve-3d;
        border-radius: var(--card-border-radius);
    }

    /* Flip the card when 'flipped' class is applied */
    .flipped .flip-card-inner {
        transform: rotateY(180deg);
    }

    /* Position the front and back side */
    .flip-card-front, .flip-card-back {
        position: absolute;
        width: 100%;
        height: 100%;
        -webkit-backface-visibility: hidden; /* Safari */
        backface-visibility: hidden;
        border-radius: var(--card-border-radius);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Style the front side (back of the card) */
    .flip-card-front {
        background-color: var(--card-background-front);
        color: var(--card-text-color);
        border: 2px solid #283593; /* Darker indigo border */
        box-shadow: inset 0 0 15px rgba(0,0,0,0.5);
    }

    .card-back-icon {
        font-size: 4em !important;
        color: rgba(255, 255, 255, 0.8);
    }

    /* Style the back side (front of the card with secret) */
    .flip-card-back {
        background-color: var(--card-background-back);
        color: black;
        transform: rotateY(180deg);
        border: 2px solid #c5cae9; /* Lighter indigo border */
    }

    .card-button-front, .card-button-back {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: transparent !important;
        color: inherit !important;
        padding: 0 !important;
        min-width: unset !important;
        border-radius: var(--card-border-radius) !important;
    }

    .card-content {
        width: 100%;
        height: 100%;
        background-color: transparent !important;
        box-shadow: none !important;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .card-inner-content {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        padding: 5px !important;
    }

    .card-text-secret {
        font-size: 2.5em; /* Adjusted for better fit */
        font-weight: bold;
        color: #333;
        word-break: break-all; /* Ensures long words wrap */
        text-align: center;
        line-height: 1.2;
    }

    .card-img-secret {
        max-width: 90%;
        max-height: 90%;
        object-fit: contain; /* Ensures image fits without distortion */
        border-radius: 5px;
    }

    /* Highlight for matched cards */
    .match .flip-card-inner {
        border: var(--card-match-border);
        box-shadow: 0 0 20px var(--card-match-border);
    }

    /* Media queries for responsiveness */
    @@media (max-width: 768px) {
        :root {
            --card-width: 100px;
            --card-height: 130px;
            --card-font-size: 2em;
        }
        .card-back-icon {
             font-size: 3em !important;
        }
         .card-text-secret {
            font-size: 2em;
        }
    }

    @@media (max-width: 480px) {
        :root {
            --card-width: 80px;
            --card-height: 110px;
            --card-font-size: 1.8em;
        }
        .card-back-icon {
             font-size: 2.5em !important;
        }
        .card-text-secret {
            font-size: 1.5em;
        }
    }
</style>