@using System.Threading.Tasks
@implements IDisposable
@inject GameStore GameStore;

<style>
    .card-grid-custom {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); /* Responsive columns */
        gap: 15px; 
        padding: 20px;
        background-color: rgba(255, 255, 255, 0.05); 
        border-radius: 15px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.5);
        justify-items: center; 
        align-items: center; 
    }

    @@media (max-width: 768px) {
        .card-grid-custom {
            grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
            gap: 10px;
            padding: 15px;
        }
    }

    @@media (max-width: 480px) {
        .card-grid-custom {
            grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
            gap: 8px;
            padding: 10px;
        }
    }
</style>

<MudContainer class="grid-container">
    <div class="card-grid-custom">
        @foreach (var secret in GameStore.Secrets)
        {
            <Card Secret="secret" />
        }
    </div>
</MudContainer>

@code {
    private void UpdateState() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        AppEvents.Instance.SecretsUpdated -= UpdateState;
    }

    protected override void OnInitialized()
    {
        AppEvents.Instance.SecretsUpdated += UpdateState;
        base.OnInitialized();
    }
}